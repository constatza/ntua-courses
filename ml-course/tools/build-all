#!/bin/sh
# Build every deck/note/exercise. Decks using the ntuabeamer class need it installed first:
#   curl -fsSL https://raw.githubusercontent.com/constatza/beamer-ntua/main/scripts/install-class.sh | sh
cd "$(dirname "$0")/.." || exit 1
rc=0
for t in presentations/*/main.tex notes/*/main.tex exercises/*/main.tex; do
  [ -f "$t" ] || continue
  d=$(dirname "$t")
  if grep -q '{ntuabeamer}' "$t" && ! kpsewhich ntuabeamer.cls >/dev/null; then
    echo "SKIP $d (ntuabeamer class not installed; see README Setup)"; rc=1; continue
  fi
  # `-pdf` would override a deck's own engine (e.g. lualatex); engine is set in each .latexmkrc
  if grep -q 'pdf_mode' "$d/.latexmkrc" 2>/dev/null; then flag=; else flag=-pdf; fi
  (cd "$d" && latexmk $flag -interaction=nonstopmode -halt-on-error main.tex >/dev/null 2>&1) \
    && echo "ok   $d" || { echo "FAIL $d"; rc=1; }
done
exit $rc
