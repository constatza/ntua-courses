#!/bin/sh
# Both courses must use the same beamer-ntua tag (same class, tools, TeX Live container).
#
#   scripts/beamer-pin            check that every course pins the same tag
#   scripts/beamer-pin set vX.Y.Z rewrite the pin in every course (commit in each course afterwards)
#
# Course content versions are separate: this only concerns the beamer-ntua dependency.
set -eu

cd "$(git rev-parse --show-toplevel)"
courses="ml-course stochastic-course"

pin_ci() { sed -n 's/.*course-ci\.yml@//p' "$1/.github/workflows/ci.yml" | head -n 1; }
pin_hooks() { awk '/constatza\/beamer-ntua/ {f=1; next} f && /rev:/ {print $2; exit}' "$1/.pre-commit-config.yaml"; }

if [ "${1:-}" = set ]; then
  tag="${2:?usage: scripts/beamer-pin set vX.Y.Z}"
  case "$tag" in v[0-9]*.[0-9]*.[0-9]*) ;; *) echo "error: tag must look like v1.2.3" >&2; exit 1 ;; esac
  for c in $courses; do
    sed -i "s|course-ci\.yml@v[0-9][0-9.]*[^ ]*|course-ci.yml@$tag|" "$c/.github/workflows/ci.yml"
    sed -i "/constatza\/beamer-ntua/{n;s|rev: .*|rev: $tag|}" "$c/.pre-commit-config.yaml"
  done
fi

rc=0
expected=""
for c in $courses; do
  for got in "$(pin_ci "$c")" "$(pin_hooks "$c")"; do
    [ -n "$expected" ] || expected="$got"
    if [ "$got" != "$expected" ]; then
      echo "FAIL $c pins $got, expected $expected"
      rc=1
    fi
  done
done
[ "$rc" -eq 0 ] && echo "ok   all courses pin beamer-ntua $expected"
exit $rc
