#!/bin/sh
# Build every deck/note/exercise. Template decks need the ntuabeamer class installed
# (see github:constatza/beamer-ntua, scripts/install-class.sh).
kpsewhich ntuabeamer.cls >/dev/null || echo "warning: ntuabeamer.cls not installed; template decks will fail" >&2
cd "$(dirname "$0")/.." || exit 1
rc=0
for t in presentations/*/main.tex notes/*/main.tex exercises/*/main.tex; do
  [ -f "$t" ] || continue
  d=$(dirname "$t")
  # `-pdf` would override a deck's own engine (e.g. lualatex); engine is set in each .latexmkrc
  if grep -q 'pdf_mode' "$d/.latexmkrc" 2>/dev/null; then flag=; else flag=-pdf; fi
  (cd "$d" && latexmk $flag -interaction=nonstopmode -halt-on-error main.tex >/dev/null 2>&1) \
    && echo "ok   $d" || { echo "FAIL $d"; rc=1; }
done
exit $rc
